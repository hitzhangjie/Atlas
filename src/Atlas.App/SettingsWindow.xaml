<Window x:Class="Atlas.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Atlas.App.Controls"
        Title="设置" Height="300" Width="540"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None"
        Icon="pack://application:,,,/Atlas;component/Assets/atlas.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BgBrush}" BorderBrush="#1C2838" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <controls:TitleBar Grid.Row="0" Title="设置"/>

            <Grid Grid.Row="1" Margin="20,16,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="启动" FontSize="14.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>

                <Border Grid.Row="1" Background="{StaticResource TableGradientBrush}"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="14,12" Margin="0,10,0,0">
                    <StackPanel>
                        <CheckBox x:Name="AutoStartCheck" Content="开机启动 Atlas"
                                  FontSize="12.5" Foreground="{StaticResource TextBrush}"
                                  Checked="AutoStartCheck_Changed" Unchecked="AutoStartCheck_Changed"/>
                        <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Text="登录 Windows 时以管理员权限自动启动 Atlas（计划任务 AtlasFan，不会弹 UAC）。"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusTextBlock" Grid.Row="2" Margin="2,12,2,0"
                           FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Top"/>

                <DockPanel Grid.Row="3" Margin="2,14,2,0">
                    <Button Content="完成" Style="{StaticResource PrimaryButton}" Padding="20,6"
                            HorizontalAlignment="Right" Click="Close_Click"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

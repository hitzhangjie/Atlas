            <PathGeometry x:Key="IconGpu"
                          Figures="M 3,8 H 16 V 16 H 3 Z M 16,10.5 H 20 V 13.5 H 16 M 4.5,11.5 A 2,2 0 1 0 8.5,11.5 A 2,2 0 1 0 4.5,11.5 M 10.5,9.8 V 14.2"/>

<Application x:Class="Atlas.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Atlas.App.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ============================================================
                 设计令牌
                 ============================================================ -->
            <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

            <SolidColorBrush x:Key="BgBrush"          Color="#0A0E15"/>
            <SolidColorBrush x:Key="BgDeepBrush"      Color="#070A10"/>
            <SolidColorBrush x:Key="TitleBarBrush"    Color="#0B1018"/>
            <SolidColorBrush x:Key="PanelBrush"       Color="#0F1621"/>
            <SolidColorBrush x:Key="Panel2Brush"      Color="#141D2B"/>
            <SolidColorBrush x:Key="PanelRaisedBrush" Color="#141D2B"/>
            <SolidColorBrush x:Key="PanelHoverBrush"  Color="#17212F"/>
            <SolidColorBrush x:Key="TableBrush"       Color="#0C121B"/>
            <SolidColorBrush x:Key="HeaderBrush"      Color="#1A1F26"/>
            <SolidColorBrush x:Key="BorderBrush2"     Color="#1E2A3D"/>
            <SolidColorBrush x:Key="BorderSoftBrush"  Color="#172030"/>
            <SolidColorBrush x:Key="TextBrush"        Color="#E8EEF8"/>
            <SolidColorBrush x:Key="MutedBrush"       Color="#93A3BA"/>
            <SolidColorBrush x:Key="DimBrush"         Color="#5F7288"/>
            <SolidColorBrush x:Key="AccentBrush"      Color="#4D9EFF"/>
            <SolidColorBrush x:Key="AccentTextBrush"  Color="#0A1628"/>
            <SolidColorBrush x:Key="AccentSoftBrush"  Color="#1A2C4A"/>
            <SolidColorBrush x:Key="CyanBrush"        Color="#46D6E6"/>
            <SolidColorBrush x:Key="GreenBrush"       Color="#45DEA5"/>
            <SolidColorBrush x:Key="AmberBrush"       Color="#F3C969"/>
            <SolidColorBrush x:Key="AmberSoftBrush"   Color="#2A2414"/>
            <SolidColorBrush x:Key="RedBrush"         Color="#FF6B81"/>
            <SolidColorBrush x:Key="WarningBrush"     Color="#F3C969"/>
            <SolidColorBrush x:Key="SelectionBrush"   Color="#16263C"/>
            <SolidColorBrush x:Key="RowAltBrush"      Color="#0E1520"/>
            <SolidColorBrush x:Key="SliderTrackBrush" Color="#1B2637"/>
            <SolidColorBrush x:Key="IconStrokeBrush"  Color="#93A3BA"/>

            <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#62B5FF" Offset="0"/>
                <GradientStop Color="#3D7BF7" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AccentGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#7CC3FF" Offset="0"/>
                <GradientStop Color="#4E8CFF" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#16202E" Offset="0"/>
                <GradientStop Color="#0E1520" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="TableGradientBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#121A26" Offset="0"/>
                <GradientStop Color="#0C121B" Offset="1"/>
            </LinearGradientBrush>

            <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility"/>

            <!-- ============================================================
                 图标几何（24×24 视图框，线性图标）
                 ============================================================ -->

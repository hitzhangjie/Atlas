<Window x:Class="Atlas.App.CurveEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Atlas.App"
        xmlns:controls="clr-namespace:Atlas.App.Controls"
        Title="编辑曲线" Height="660" Width="780"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        WindowStyle="None"
        Icon="pack://application:,,,/Atlas;component/Assets/atlas.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BgBrush}" BorderBrush="#1C2838" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <controls:TitleBar x:Name="TitleBarControl" Grid.Row="0" Title="编辑曲线"/>

            <Grid Grid.Row="1" Margin="20,16,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="2,0,2,12">
                    <StackPanel>
                        <TextBlock Text="温度 → PWM 曲线" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Margin="0,4,0,0" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                   Text="拖动圆点调整曲线 · 双击空白处添加控制点 · 右键删除控制点"/>
                    </StackPanel>
                    <Border Style="{StaticResource ChipBorder}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource CyanBrush}" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource ChipText}" Text="横轴 20–100 °C · 纵轴 0–100 %" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Border>
                </DockPanel>

                <Border Grid.Row="1" Background="{StaticResource TableGradientBrush}"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                        CornerRadius="10" ClipToBounds="True" Padding="1">
                    <local:CurveEditor x:Name="Editor" MinHeight="300" ClipToBounds="True"/>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,14,2,0">
                    <TextBlock Text="预设" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               FontSize="11.5" Margin="0,0,10,0"/>
                    <Button Content="静音" Style="{StaticResource SmallGhostButton}" Padding="16,6" Margin="0,0,6,0"
                            Click="PresetQuiet_Click"/>
                    <Button Content="均衡" Style="{StaticResource SmallGhostButton}" Padding="16,6" Margin="0,0,6,0"
                            Click="PresetBalanced_Click"/>
                    <Button Content="性能" Style="{StaticResource SmallGhostButton}" Padding="16,6" Margin="0,0,6,0"
                            Click="PresetPerformance_Click"/>
                    <Button Content="恢复默认" Style="{StaticResource SmallGhostButton}" Padding="16,6"
                            Click="Reset_Click"/>
                </StackPanel>

                <Border Grid.Row="3" Background="#0E1520" BorderBrush="{StaticResource BorderSoftBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="11,7" Margin="2,12,2,0">
                    <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedBrush}"
                               FontSize="11.5" TextWrapping="Wrap"/>
                </Border>

                <DockPanel Grid.Row="4" Margin="2,14,2,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Style="{StaticResource GhostButton}" Padding="18,6" Margin="0,0,8,0"
                                Click="Cancel_Click"/>
                        <Button Content="确定" Style="{StaticResource PrimaryButton}" Padding="20,6"
                                Click="Ok_Click"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

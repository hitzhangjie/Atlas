<Window x:Class="Atlas.App.CopyCurveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Atlas.App.Controls"
        Title="复制曲线" Height="520" Width="470"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        WindowStyle="None"
        Icon="pack://application:,,,/Atlas;component/Assets/atlas.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BgBrush}" BorderBrush="#1C2838" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <controls:TitleBar Grid.Row="0" Title="复制曲线" Subtitle="批量应用温度曲线"/>

            <Grid Grid.Row="1" Margin="20,16,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="2,0,2,0">
                    <TextBlock x:Name="HeaderText" FontSize="14.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="勾选要应用同一曲线的其他通道（应用后这些通道会切换为「温度曲线」模式）。"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="目标通道" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="2,16,2,8"/>

                <Border Grid.Row="2" Background="{StaticResource TableGradientBrush}"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="TargetList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" CornerRadius="6" Padding="6,5">
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding Checked, Mode=TwoWay}"
                                                  HorizontalAlignment="Left"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Row="3" Margin="2,14,2,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="全选" Style="{StaticResource SmallGhostButton}" Padding="12,5" Margin="0,0,6,0"
                                Click="SelectAll_Click"/>
                        <Button Content="全不选" Style="{StaticResource SmallGhostButton}" Padding="12,5"
                                Click="SelectNone_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Style="{StaticResource GhostButton}" Padding="18,6" Margin="0,0,8,0"
                                Click="Cancel_Click"/>
                        <Button Content="应用" Style="{StaticResource PrimaryButton}" Padding="20,6"
                                Click="Ok_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

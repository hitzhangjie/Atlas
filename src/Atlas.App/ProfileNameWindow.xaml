<Window x:Class="Atlas.App.ProfileNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Atlas.App.Controls"
        Title="配置名称" Height="280" Width="520"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        WindowStyle="None"
        Icon="pack://application:,,,/Atlas;component/Assets/atlas.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BgBrush}" BorderBrush="#1C2838" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <controls:TitleBar x:Name="TitleBarControl" Grid.Row="0" Title="配置名称"/>

            <Grid Grid.Row="1" Margin="20,16,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="2,0,2,0">
                    <TextBlock x:Name="HeaderText" FontSize="14.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Text="名称会显示在「我的配置」下拉框中；内置场景名（静音 / 均衡 / 性能）为只读，不能用作配置名。"/>
                </StackPanel>

                <TextBox x:Name="NameBox" Grid.Row="1" Margin="2,16,2,0" Height="32"
                         MaxLength="24" FontSize="12.5"
                         ToolTip="给这套配置起一个容易辨认的名字，例如「夜间安静」"
                         KeyDown="NameBox_KeyDown"/>

                <TextBlock x:Name="ErrorText" Grid.Row="2" Margin="2,8,2,0"
                           FontSize="11.5" Foreground="{StaticResource RedBrush}"
                           TextWrapping="Wrap" Visibility="Collapsed"/>

                <DockPanel Grid.Row="4" Margin="2,14,2,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Style="{StaticResource GhostButton}" Padding="18,6" Margin="0,0,8,0"
                                Click="Cancel_Click"/>
                        <Button Content="保存" Style="{StaticResource PrimaryButton}" Padding="20,6"
                                Click="Ok_Click"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

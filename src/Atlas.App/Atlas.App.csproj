<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Atlas</AssemblyName>
    <RootNamespace>Atlas.App</RootNamespace>
    <Version>0.2.0</Version>
    <Product>Atlas</Product>
    <Description>风扇控制与传感器监控（个人版）</Description>
    <ApplicationIcon>Assets\atlas.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Atlas.Core\Atlas.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\atlas.ico" />
    <Resource Include="Assets\atlas-mark.png" />
    <Resource Include="Assets\atlas-mark-128.png" />
  </ItemGroup>
</Project>

<UserControl x:Class="Atlas.App.Controls.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Height="46"
             Background="{StaticResource TitleBarBrush}"
             FontFamily="{StaticResource UiFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border VerticalAlignment="Bottom" Height="1" Background="#141D2A"/>

        <!-- 品牌区（属于标题栏拖拽区域） -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
            <Image x:Name="BrandMark"
                   Width="22" Height="22"
                   Source="pack://application:,,,/Atlas;component/Assets/atlas-mark.png"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   VerticalAlignment="Center"/>
            <TextBlock x:Name="TitleText"
                       Text="{Binding Title, ElementName=Root}"
                       FontSize="14.5" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Border x:Name="VersionChip"
                    Background="{StaticResource AccentSoftBrush}"
                    BorderBrush="#22385C" BorderThickness="1"
                    CornerRadius="6" Padding="6,1.5" Margin="9,0,0,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding Version, ElementName=Root, Converter={StaticResource NotEmptyToVisibility}}">
                <TextBlock Text="{Binding Version, ElementName=Root}"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="#79B6FF"/>
            </Border>
            <Border x:Name="Divider"
                    Width="1" Height="15"
                    Background="#253141"
                    Margin="12,0,12,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding Subtitle, ElementName=Root, Converter={StaticResource NotEmptyToVisibility}}"/>
            <TextBlock x:Name="SubtitleText"
                       Text="{Binding Subtitle, ElementName=Root}"
                       FontSize="12" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       Visibility="{Binding Subtitle, ElementName=Root, Converter={StaticResource NotEmptyToVisibility}}"/>
        </StackPanel>

        <!-- 状态 + 窗口按钮（需要可点击，必须标记为可命中标题栏） -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Border x:Name="StatusChip"
                    Background="{StaticResource PanelRaisedBrush}"
                    BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="9,4" Margin="0,11,10,0"
                    VerticalAlignment="Center"
                    Visibility="{Binding StatusText, ElementName=Root, Converter={StaticResource NotEmptyToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}"
                             VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding StatusText, ElementName=Root}"
                               FontSize="11" Foreground="#A9C4E4" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Button x:Name="MinButton" Style="{StaticResource TitleBarButton}"
                    Click="MinButton_Click" ToolTip="最小化">
                <Path Style="{StaticResource TitleBarIcon}" Data="{StaticResource IconMin}"/>
            </Button>
            <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}"
                    Click="MaxButton_Click" ToolTip="最大化 / 还原">
                <Path x:Name="MaxIcon" Style="{StaticResource TitleBarIcon}" Data="{StaticResource IconMax}"/>
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButton}"
                    Click="CloseButton_Click" ToolTip="关闭">
                <Path Style="{StaticResource TitleBarIcon}" Data="{StaticResource IconClose}"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>

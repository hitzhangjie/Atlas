<UserControl x:Class="Atlas.App.Controls.SceneBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             FontFamily="{StaticResource UiFont}"
             FontSize="12"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True">
    <!-- v2：单一下拉（内置场景 + 我的配置 + 未归档占位），选择即切换；
         不再有「应用」按钮、三个场景按钮、只读徽标和右侧「当前方案」状态 chip。
         当前来源由下拉选中项表达，未保存修改只用一个很小的琥珀「已修改」徽标提示。 -->
    <Border Style="{StaticResource CardBorder}" Padding="14,0" Height="58">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 标题 ===== -->
            <TextBlock Grid.Column="0" Text="切换配置" FontSize="11.5"
                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                       ToolTip="内置场景（只读）：把所有未锁定通道切换为温度曲线并套用同名曲线模板。&#10;「我的配置」：你自己命名并保存的整套设置，可保存、另存为、重命名、删除。"/>

            <!-- ===== 单一下拉：选中即切换 ===== -->
            <ComboBox x:Name="ChoiceCombo" Grid.Column="1" Width="320" Margin="10,0,0,0"
                      VerticalAlignment="Center" HorizontalContentAlignment="Stretch"
                      ToolTip="内置场景只读；选择即切换。要修改请先复制为「我的配置」。"
                      SelectionChanged="ChoiceCombo_SelectionChanged">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 类型徽标：内置 · 只读 / 我的 / 未归档 -->
                            <Border x:Name="KindBadge" Grid.Column="0" Padding="6,1" Margin="0,0,8,0"
                                    CornerRadius="5" BorderThickness="1" VerticalAlignment="Center"
                                    Background="#111A27" BorderBrush="{StaticResource BorderSoftBrush}">
                                <TextBlock x:Name="KindText" Text="{Binding TypeLabel}" FontSize="9.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                       MaxWidth="170" VerticalAlignment="Center"
                                       ToolTip="{Binding DisplayName}"/>

                            <!-- 我的配置附带更新时间 -->
                            <TextBlock Grid.Column="2" Text="{Binding DetailText}" Margin="8,0,0,0"
                                       FontSize="10" Foreground="{StaticResource DimBrush}"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding DetailText, Converter={StaticResource NotEmptyToVisibility}}"/>
                        </Grid>
                        <DataTemplate.Triggers>
                            <!-- 内置场景：青色描边只读感 -->
                            <DataTrigger Binding="{Binding Kind}" Value="BuiltInScene">
                                <Setter TargetName="KindBadge" Property="Background" Value="#12252B"/>
                                <Setter TargetName="KindBadge" Property="BorderBrush" Value="#2A5058"/>
                                <Setter TargetName="KindText" Property="Foreground" Value="{StaticResource CyanBrush}"/>
                            </DataTrigger>
                            <!-- 我的配置：Accent -->
                            <DataTrigger Binding="{Binding Kind}" Value="Profile">
                                <Setter TargetName="KindBadge" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter TargetName="KindBadge" Property="BorderBrush" Value="#22385C"/>
                                <Setter TargetName="KindText" Property="Foreground" Value="#79B6FF"/>
                            </DataTrigger>
                            <!-- 未归档占位：Muted -->
                            <DataTrigger Binding="{Binding Kind}" Value="Draft">
                                <Setter TargetName="KindBadge" Property="Background" Value="#111A27"/>
                                <Setter TargetName="KindBadge" Property="BorderBrush" Value="{StaticResource BorderSoftBrush}"/>
                                <Setter TargetName="KindText" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- ===== 已修改：很小的琥珀徽标，仅 IsDirty 时可见 ===== -->
            <Border x:Name="DirtyBadge" Grid.Column="2" Style="{StaticResource ChipBorder}"
                    Margin="9,0,0,0" Padding="7,2" Visibility="Collapsed"
                    Background="{StaticResource AmberSoftBrush}" BorderBrush="#4A3D22"
                    ToolTip="当前方案有未保存的修改。">
                <TextBlock Text="已修改" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource AmberBrush}" VerticalAlignment="Center"/>
            </Border>

            <!-- ===== 右侧配置动作（不再有「应用」按钮） ===== -->
            <StackPanel Grid.Column="4" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="SaveProfileButton" Style="{StaticResource PrimaryButton}"
                        Padding="11,5" Margin="0,0,4,0" Click="SaveProfileButton_Click"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="把当前修改保存到所选「我的配置」。没有未保存的修改时置灰。">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconSave}" Style="{StaticResource IconPath}"
                              Stroke="{StaticResource AccentTextBrush}" Width="12" Height="12"
                              Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="保存" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="SaveAsProfileButton" Content="另存为" Style="{StaticResource ToolbarButton}"
                        Padding="10,5" Margin="0,0,4,0" Click="SaveAsProfileButton_Click"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="把当前所有通道的设置另存为一个新的「我的配置」，内置场景不受影响。"/>
                <Button x:Name="RenameProfileButton" Content="重命名" Style="{StaticResource ToolbarButton}"
                        Padding="10,5" Margin="0,0,4,0" Click="RenameProfileButton_Click"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="给所选「我的配置」改名（只改名字，不改保存的曲线内容）。"/>
                <Button x:Name="DeleteProfileButton" Content="删除" Style="{StaticResource ToolbarButton}"
                        Padding="10,5" Click="DeleteProfileButton_Click"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="删除所选「我的配置」（只删除这个保存的配置，当前正在生效的方案设置不会改变）。"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

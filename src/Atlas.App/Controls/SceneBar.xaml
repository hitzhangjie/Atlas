<UserControl x:Class="Atlas.App.Controls.SceneBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             FontFamily="{StaticResource UiFont}"
             FontSize="12"
             TextOptions.TextFormattingMode="Display"
             UseLayoutRounding="True">
    <Border Style="{StaticResource CardBorder}" Padding="14,0" Height="58">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 内置场景模板（只读） ===== -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="场景模板" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           ToolTip="内置场景（只读）：一键把所有未锁定通道切换为温度曲线并套用同名曲线模板。场景值不能修改；调整后请另存为「我的配置」。"/>
                <Border Style="{StaticResource ChipBorder}" Padding="6,2" Margin="7,0,10,0"
                        Background="{StaticResource AccentSoftBrush}" BorderBrush="#22385C"
                        ToolTip="内置模板与场景由程序内置，不能修改、改名或删除。">
                    <TextBlock Text="只读" FontSize="10" FontWeight="SemiBold"
                               Foreground="#79B6FF" VerticalAlignment="Center"/>
                </Border>
                <StackPanel x:Name="SceneButtonsPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- ===== 分隔线 ===== -->
            <Border Grid.Column="1" Width="1" Height="28" Margin="11,0,15,0"
                    Background="{StaticResource BorderBrush2}" VerticalAlignment="Center"/>

            <!-- ===== 我的配置（可改名 / 更新 / 删除） ===== -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="我的配置" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           ToolTip="「我的配置」是你保存的整套设置（可改名、更新、删除），和只读的内置场景不是一回事。"/>

                <ComboBox x:Name="ProfileCombo" Width="140" Margin="8,0,6,0" VerticalAlignment="Center"
                          ToolTip="选择要应用 / 更新 / 重命名 / 删除的「我的配置」"
                          SelectionChanged="ProfileCombo_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button x:Name="ApplyProfileButton" Content="应用" Style="{StaticResource ToolbarButton}"
                        Padding="10,5" Margin="0,0,4,0" Click="ApplyProfileButton_Click"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="把所选「我的配置」套用到所有未锁定通道，会覆盖当前方案。"/>

                <Button x:Name="SaveProfileButton" Style="{StaticResource PrimaryButton}"
                        Padding="11,5" Margin="0,0,4,0" Click="SaveProfileButton_Click"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="把当前所有通道的设置保存为一个新的「我的配置」，内置场景不受影响。">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconSave}" Style="{StaticResource IconPath}"
                              Stroke="{StaticResource AccentTextBrush}" Width="12" Height="12"
                              Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="保存当前…" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="UpdateProfileButton" Content="更新" Style="{StaticResource ToolbarButton}"
                        Padding="10,5" Margin="0,0,4,0" Click="UpdateProfileButton_Click"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="用当前设置覆盖所选「我的配置」（内置场景不可覆盖）。"/>

                <Button x:Name="RenameProfileButton" Content="重命名" Style="{StaticResource ToolbarButton}"
                        Padding="10,5" Margin="0,0,4,0" Click="RenameProfileButton_Click"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="给所选「我的配置」改名（只改名字，不改保存的曲线内容）。"/>

                <Button x:Name="DeleteProfileButton" Content="删除" Style="{StaticResource ToolbarButton}"
                        Padding="10,5" Click="DeleteProfileButton_Click"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="删除所选「我的配置」（只删除这个保存的配置，当前正在生效的方案设置不会改变）。"/>
            </StackPanel>

            <!-- ===== 当前方案状态 ===== -->
            <Border x:Name="StatusChip" Grid.Column="3" Style="{StaticResource ChipBorder}"
                    Margin="12,0,0,0" Padding="10,4"
                    ToolTip="当前方案 = 正在编辑并实时生效的设置。套用场景/配置后若再改动扇通道，会标记为「已修改」，需要另存为配置才能保留。">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="当前方案" FontSize="10.5"
                               Foreground="{StaticResource DimBrush}" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <Ellipse x:Name="StatusDot" Grid.Column="1" Width="6" Height="6"
                             Fill="{StaticResource GreenBrush}" VerticalAlignment="Center"
                             Margin="0,0,7,0"/>

                    <TextBlock x:Name="StatusTextBlock" Grid.Column="2" Text="自定义方案（未归档）"
                               FontSize="11.5" Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

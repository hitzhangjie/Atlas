<Window x:Class="Atlas.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Atlas.App.Controls"
        xmlns:local="clr-namespace:Atlas.App"
        Title="Atlas · 风扇控制台" Height="900" Width="1360" MinHeight="780" MinWidth="1180"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Icon="pack://application:,,,/Atlas;component/Assets/atlas.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource BgBrush}" BorderBrush="#1C2838" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <controls:TitleBar Grid.Row="0"
                               Title="Atlas" Subtitle="风扇控制台" Version="v0.3-dev"
                               StatusText="实时监控中"/>

            <Grid Grid.Row="1" Margin="22,16,22,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ===== 传感器卡片：主指标 = 普通用户关心的部件温度；工程师指标放副标题 ===== -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Border Width="34" Height="34" CornerRadius="10" Background="#16263C" Margin="0,0,11,0">
                                    <Path Data="{StaticResource IconCpu}" Style="{StaticResource IconPath}"
                                          Stroke="{StaticResource AccentBrush}" Width="18" Height="18"/>
                                </Border>
                                <TextBlock Style="{StaticResource CardLabel}" Text="CPU 温度"
                                           ToolTip="CPU Package（封装）温度，和大多数监控软件显示的 CPU 温度一致"/>
                                <TextBlock x:Name="CpuTempState" Style="{StaticResource StateLabel}"
                                           Text="--" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9,0,10">
                                <TextBlock x:Name="CpuTempText" Style="{StaticResource CardValue}" Text="--"/>
                                <TextBlock Style="{StaticResource CardUnit}" Text="°C"/>
                            </StackPanel>
                            <ProgressBar x:Name="CpuTempBar" Grid.Row="2" Minimum="0" Maximum="100" Value="0"/>
                            <TextBlock x:Name="CpuCoreDetailText" Grid.Row="3" Text="Package 传感器"
                                       Margin="0,7,0,0" FontSize="10.5"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="10,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Border Width="34" Height="34" CornerRadius="10" Background="#152B2C" Margin="0,0,11,0">
                                    <Path Data="{StaticResource IconGpu}" Style="{StaticResource IconPath}"
                                          Stroke="{StaticResource CyanBrush}" Width="18" Height="18"/>
                                </Border>
                                <TextBlock Style="{StaticResource CardLabel}" Text="GPU 温度"
                                           ToolTip="NVIDIA 驱动 / 游戏内显示的 GPU 温度（核心 edge 温度）"/>
                                <TextBlock x:Name="GpuTempState" Style="{StaticResource StateLabel}"
                                           Text="--" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9,0,10">
                                <TextBlock x:Name="GpuTempText" Style="{StaticResource CardValue}" Text="--"/>
                                <TextBlock Style="{StaticResource CardUnit}" Text="°C"/>
                            </StackPanel>
                            <ProgressBar x:Name="GpuTempBar" Grid.Row="2" Minimum="0" Maximum="100" Value="0"
                                         Foreground="{StaticResource CyanBrush}"/>
                            <TextBlock x:Name="GpuDetailText" Grid.Row="3" Text="热点 -- · 显存 --" Margin="0,7,0,0"
                                       FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="热点（Hot Spot / 结温）通常比核心高 10–20 °C；显存为 GDDR6X 结温。两项都只作散热健康参考。"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="10,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <Border Width="34" Height="34" CornerRadius="10" Background="#1B2233" Margin="0,0,11,0">
                                    <Path Data="{StaticResource IconMemory}" Style="{StaticResource IconPath}"
                                          Stroke="#A6B8FF" Width="18" Height="18"/>
                                </Border>
                                <TextBlock Style="{StaticResource CardLabel}" Text="内存最高温"
                                           ToolTip="系统内存（DIMM SPD）温度，取所有内存条中的最高值"/>
                                <TextBlock x:Name="DimmState" Style="{StaticResource StateLabel}"
                                           Text="--" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9,0,10">
                                <TextBlock x:Name="DimmText" Style="{StaticResource CardValue}" Text="--"/>
                                <TextBlock Style="{StaticResource CardUnit}" Text="°C"/>
                            </StackPanel>
                            <ProgressBar x:Name="DimmBar" Grid.Row="2" Minimum="0" Maximum="100" Value="0"
                                         Foreground="#A6B8FF"/>
                            <TextBlock x:Name="DimmDetailText" Grid.Row="3" Text="系统内存 SPD"
                                       Margin="0,7,0,0" FontSize="10.5"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ===== 提示条 ===== -->
                <Border Grid.Row="1" Background="{StaticResource AmberSoftBrush}"
                        BorderBrush="#4A3D22" BorderThickness="1" CornerRadius="10"
                        Padding="12,9" Margin="0,14,0,0">
                    <DockPanel>
                        <Path Data="{StaticResource IconInfo}" Style="{StaticResource IconPath}"
                              Stroke="{StaticResource AmberBrush}" Width="16" Height="16"
                              VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock x:Name="HintText" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="#E4CD92" FontSize="11.5"
                                   Text="提示：Fan #7 恒定高转速，疑似水泵——启用前请确认接线；勾选「锁定」可禁止 Atlas 写该通道。"/>
                    </DockPanel>
                </Border>

                <!-- ===== 场景模板 / 我的配置 / 当前方案 ===== -->
                <controls:SceneBar x:Name="SceneBarControl" Grid.Row="2" Margin="0,12,0,0"/>

                <!-- ===== 风扇通道表格 ===== -->
                <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0" Margin="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="16,12,16,11">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="风扇通道" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource ChipBorder}" Margin="10,0,0,0">
                                    <TextBlock x:Name="ChannelCountText" Style="{StaticResource ChipText}" Text="0 个通道"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ToggleButton x:Name="HideZeroButton" Style="{StaticResource SwitchToggle}"
                                              Content="隐藏 0 RPM" Margin="0,0,6,0"
                                              Checked="HideZero_Changed" Unchecked="HideZero_Changed"/>

                                <Button x:Name="CopyCurveButton" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="复制曲线"
                                        Click="CopyCurveButton_Click" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconCopy}" Style="{StaticResource IconPath}"
                                              Stroke="#9FB4CF" Width="14" Height="14" Margin="0,0,6,0"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="复制曲线" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="SettingsButton" Style="{StaticResource ToolbarButton}" AutomationProperties.Name="设置"
                                        Click="SettingsButton_Click" Margin="0,0,4,0">
                                    <TextBlock Text="设置" VerticalAlignment="Center"/>
                                </Button>

                                <Button x:Name="RestoreButton" Style="{StaticResource AmberGhostButton}" AutomationProperties.Name="全部恢复 BIOS 默认"
                                        Click="RestoreButton_Click" Margin="2,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconRefresh}" Style="{StaticResource IconPath}"
                                              Stroke="{StaticResource AmberBrush}" Width="14" Height="14"
                                              Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="全部恢复 BIOS 默认" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1" Background="{StaticResource TableGradientBrush}"
                                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                                CornerRadius="10" Margin="14,0,14,14" ClipToBounds="True">
                            <DataGrid x:Name="FanGrid"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      CanUserResizeRows="False" CanUserSortColumns="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="{StaticResource TextBrush}" RowHeight="50"
                                      HorizontalGridLinesBrush="#131C29"
                                      VerticalGridLinesBrush="Transparent"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      SelectionUnit="FullRow" SelectionMode="Single"
                                      ColumnHeaderHeight="38">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                        <Setter Property="Height" Value="50"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="通道" Width="212" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="8" Background="#152234"
                                                            Margin="0,0,10,0">
                                                        <Path Data="{StaticResource IconFan}" Fill="#5FB3FF"
                                                              Width="15" Height="15" Stretch="Uniform"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                                   Foreground="{StaticResource TextBrush}"/>
                                                        <TextBlock Text="{Binding HardwareLabel}" FontSize="10"
                                                                   Foreground="{StaticResource DimBrush}" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="转速" Width="106" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding RpmText}" FontFamily="{StaticResource MonoFont}"
                                                           FontSize="12" HorizontalAlignment="Right"
                                                           Foreground="{StaticResource TextBrush}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="当前 PWM" Width="128" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding PercentText}" FontFamily="{StaticResource MonoFont}"
                                                               FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{StaticResource TextBrush}" Width="38"/>
                                                    <ProgressBar Grid.Column="1" Height="4" Minimum="0" Maximum="100"
                                                                 Value="{Binding PwmValue, Mode=OneWay}"
                                                                 VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="模式" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Modes}"
                                                          SelectedItem="{Binding SelectedMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="{Binding SelectedMode.Display}"
                                                          PreviewMouseLeftButtonDown="PresetEditGuard_PreviewMouseLeftButtonDown">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Display}" Foreground="{StaticResource TextBrush}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="温度源" Width="*" MinWidth="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Sources}"
                                                          SelectedItem="{Binding SelectedSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="{Binding SelectedSource.DisplayName}"
                                                          PreviewMouseLeftButtonDown="PresetEditGuard_PreviewMouseLeftButtonDown">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextBrush}"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="固定 PWM" Width="158">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                                                            Value="{Binding FixedPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            IsEnabled="{Binding IsFixedMode}" VerticalAlignment="Center"
                                                            PreviewMouseLeftButtonDown="PresetEditGuard_PreviewMouseLeftButtonDown"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding FixedPercentText}"
                                                               VerticalAlignment="Center" TextAlignment="Right"
                                                               FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                               Foreground="{StaticResource MutedBrush}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="曲线" Width="280">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <local:CurveSparkline Width="66" Height="26" Margin="0,0,9,0"
                                                                         Points="{Binding CurvePoints}"
                                                                         ToolTip="{Binding CurveText}"
                                                                         VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CurveOriginText}" FontSize="10"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding CurveOriginText, Converter={StaticResource NotEmptyToVisibility}}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurveFromTemplate}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding CurveText}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" FontSize="10.5"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   ToolTip="{Binding CurveText}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="编辑" AutomationProperties.Name="编辑"
                                                            Style="{StaticResource SmallGhostButton}"
                                                            Margin="8,0,0,0"
                                                            Click="EditCurve_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridCheckBoxColumn Header="锁定" Width="62"
                                                            ElementStyle="{StaticResource GridCheckBoxStyle}"
                                                            Binding="{Binding Protected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===== 状态栏 ===== -->
                <Grid Grid.Row="4" Margin="2,12,2,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource GreenBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="就绪" Foreground="{StaticResource MutedBrush}"
                                   FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
